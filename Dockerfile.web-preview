FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    python3 \
    python3-venv \
    libgl1 \
    libglib2.0-0 \
    libxrender1 \
    libxext6 \
    libsm6 \
  && rm -rf /var/lib/apt/lists/*

COPY . .

RUN npm ci
RUN npm --prefix renderer install
RUN npm run build:web

RUN python3 -m venv /opt/math3d-venv
ENV PATH="/opt/math3d-venv/bin:${PATH}"
RUN pip install --no-cache-dir --upgrade pip \
  && pip install --no-cache-dir numpy scipy sympy vtk

ENV MATH3D_WORKER_MODE=python
ENV MATH3D_PYTHON=/opt/math3d-venv/bin/python
ENV MATH3D_WEB_WORKER_PROXY_HOST=0.0.0.0
ENV MATH3D_WEB_WORKER_PROXY_PORT=8787

EXPOSE 4173 8787

CMD ["npm", "run", "preview:web"]
