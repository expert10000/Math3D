{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "preload.ts",
    "renderer/src/**/*.ts",
    "renderer/src/**/*.tsx"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.d.ts",
    "dist/**",
    "build/**",
    "renderer/dist/**",
    "legacy/**",
    "tests/**",
    "test-results/**",
    "playwright-report/**",
    "node_modules/**"
  ]
}
