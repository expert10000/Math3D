{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "paths": {
      "@math3d/core": ["../packages/core/src/index.ts"],
      "@math3d/core/*": ["../packages/core/src/*"],
      "@math3d/renderer-web": ["../packages/renderer-web/src/index.ts"],
      "@math3d/renderer-web/*": ["../packages/renderer-web/src/*"],
      "@math3d/ui": ["../packages/ui/src/index.ts"],
      "@math3d/ui/*": ["../packages/ui/src/*"],
      "@math3d/workbook": ["../packages/workbook/src/index.ts"],
      "@math3d/api-client": ["../packages/api-client/src/index.ts"],
      "@math3d/workbook/*": ["../packages/workbook/src/*"],
      "@math3d/api-client/*": ["../packages/api-client/src/*"],
      "three": ["./node_modules/@types/three/index.d.ts"],
      "three/*": ["./node_modules/@types/three/*"]
    },
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "src",
    "../packages/core/src/**/*.ts",
    "../packages/renderer-web/src/**/*.ts",
    "../packages/ui/src/**/*.ts",
    "../packages/workbook/src/**/*.ts",
    "../packages/api-client/src/**/*.ts"
  ]
}

