{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",

    "rootDir": "src",
    "outDir": ".",                 // src/main.ts -> main.js in project root

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"]
  },
  "include": [
    "src/main.ts"
    // add "src/preload.ts" here too if you actually have that file
  ]
}
