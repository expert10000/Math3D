{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "src",
    "outDir": ".",                 // src/main.ts -> main.js in project root
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"]
  },
  "include": [
    "src/main.ts"
    // "src/preload.ts"  <-- if it exists
  ]
}
