@startuml

scale max 1920 width
top to bottom direction

skinparam nodesep 12
skinparam ranksep 24
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Tahoma
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam dpi 150
skinparam arrowColor black
skinparam arrowThickness 0.5
skinparam packageTitleAlignment left

' oval
skinparam usecase {
  borderThickness 0.5
}

' rectangle
skinparam rectangle {
  borderThickness 0.5
}

' component
skinparam component {
  borderThickness 1
}


rectangle "cgalMeshIpc" as _cgalMeshIpc
(<b>main</b>)
rectangle "<b>preload</b>" as _preload
rectangle "presetsDb" as _presetsDb
rectangle "pythonWorker" as _pythonWorker
rectangle "pythonWorkerDiagnostics" as _pythonWorkerDiagnostics
rectangle "vtkMeshIpc" as _vtkMeshIpc


_cgalMeshIpc --> _pythonWorker
_cgalMeshIpc --> _pythonWorkerDiagnostics
(<b>main</b>) --[thickness=1]> _cgalMeshIpc
(<b>main</b>) -[thickness=1]> _presetsDb
(<b>main</b>) --[thickness=1]> _pythonWorker
(<b>main</b>) --[thickness=1]> _pythonWorkerDiagnostics
(<b>main</b>) --[thickness=1]> _vtkMeshIpc
_pythonWorker --> _cgalMeshIpc
_pythonWorkerDiagnostics --> _pythonWorker
_vtkMeshIpc --> _pythonWorker
_vtkMeshIpc --> _pythonWorkerDiagnostics

@enduml

