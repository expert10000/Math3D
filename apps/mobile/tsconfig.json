{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "resolvePackageJsonExports": false,
    "paths": {
      "@math3d/core": ["../../packages/core/src/index.ts"],
      "@math3d/kernel": ["../../packages/kernel/src/index.ts"],
      "@math3d/api-client": ["../../packages/api-client/src/index.ts"]
    }
  },
  "include": [
    "App.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts"
  ]
}
